# ── Backend ─────────────────────────────────────────────────────
APP_ID=local-dev-app
APP_SECRET=local-dev-secret-change-me

# ── Database (optional) ─────────────────────────────────────────
# MySQL / PlanetScale connection string. When unset, the server
# persists simulation runs to .data/simulation-runs.json instead.
DATABASE_URL=

# ── LLM deliberation (optional) ─────────────────────────────────
# OpenAI-compatible chat API (default: OpenRouter free models).
# Without a key the Council still convenes on the deterministic engine.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_PRIMARY=google/gemma-4-31b-it:free
LLM_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free
