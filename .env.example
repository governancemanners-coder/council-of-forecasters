# ── Backend ─────────────────────────────────────────────────────
# Required only when NODE_ENV=production.
APP_ID=
APP_SECRET=

# ── LLM (optional) ──────────────────────────────────────────────
# OpenAI-compatible chat completions. When LLM_API_KEY is empty, convene
# stays on the deterministic engine.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL_PRIMARY=google/gemma-4-31b-it:free
LLM_MODEL_FALLBACK=google/gemma-4-26b-a4b-it:free

# ── Database (optional) ─────────────────────────────────────────
# MySQL connection string. When empty, runs are not stored.
# Local socket auth (no password), after scripts/ensure-mysql.sh:
# mysql://ubuntu@localhost/council?socketPath=/tmp/mysql.sock
DATABASE_URL=
